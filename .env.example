# Copy this file to .env and fill in your key.
OPENAI_API_KEY=sk-...

# Any OpenAI model that can see images.
OPENAI_MODEL=gpt-4.1-mini

# How often to take a screenshot, in seconds.
CAPTURE_INTERVAL_SECONDS=30

# Number of warnings before the screen locks.
MAX_WARNINGS=3

# Screenshot is shrunk to this width before upload (smaller = cheaper).
IMAGE_WIDTH=1280

# How much detail OpenAI keeps: low (about 512x512, cheapest), high, or auto.
IMAGE_DETAIL=low

# full = the whole screen. crop = a random part of the screen, most often
# near the middle.
CAPTURE_MODE=full

# Size of the crop as a fraction of the screen (0.5 = half the width and
# half the height). Only used when CAPTURE_MODE=crop.
CROP_SIZE=0.5

# true = warn but never lock. Good for testing.
DRY_RUN=false
