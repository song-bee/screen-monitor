# Copy this file to .env and fill in your key.
OPENAI_API_KEY=sk-...

# Any OpenAI model that can see images.
OPENAI_MODEL=gpt-4.1-mini

# How often to take a screenshot, in seconds.
CAPTURE_INTERVAL_SECONDS=30

# Number of warnings before the screen locks.
MAX_WARNINGS=3

# Screenshot is shrunk to this width before upload (smaller = cheaper).
IMAGE_WIDTH=1280

# How much detail OpenAI keeps: low (about 512x512, cheapest), high, or auto.
IMAGE_DETAIL=low

# full = the whole screen. crop = a random part of the screen, most often
# near the middle.
CAPTURE_MODE=full

# Size of the crop as a fraction of the screen (0.5 = half the width and
# half the height). Only used when CAPTURE_MODE=crop.
CROP_SIZE=0.5

# The crop box always stays inside this middle part of the screen
# (0.8 = the middle 80%). Every spot inside it is equally likely.
# 1.0 = anywhere on the screen. Only used when CAPTURE_MODE=crop.
CROP_ZONE=0.8

# true = warn but never lock. Good for testing.
DRY_RUN=false

# How long a warning stays on screen, in seconds. It shows as a small box
# that closes itself. 0 = a normal macOS banner (closes after about 5s).
NOTIFY_SECONDS=15

# What counts as off-task. Separate items with ';'. The name before '('
# shows in logs and warnings; the words in '( )' are examples for the model.
# Add, remove, or edit items freely. Everything else is allowed.
BLOCKED_CATEGORIES=video game; novel (web novel, e-book, light novel, manga, fan fiction); video (YouTube, Netflix, Bilibili, TikTok, streaming, movies, TV shows); social media (Twitter/X, Instagram, Facebook, Reddit, Weibo, Xiaohongshu feeds); AI chat in Chinese (ChatGPT, Claude, Gemini, DeepSeek, Doubao, Kimi, or any chatbot where the chat messages are mostly Chinese, even if the app menus are in English. AI chat in English is fine)
